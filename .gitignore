# Build artifacts
/target
crates/*/target/
debug/
release/

# Tauri build artifacts (the ACL and capability schemas are regenerated by
# `tauri-build` on every build; the capability file's `$schema` points at them
# only as an editor hint)
crates/*/gen/schemas/

# Desktop GUI release output (the binary plus its build-metadata sidecar).
# scripts/build_gui_release.sh writes here by default; the artefacts are
# build products, never source.
/dist/

# Pre-built binaries
/eggsec
eggsec.exe
*.o
*.a
*.so
*.dylib
*.dll

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS artifacts
.DS_Store
._*
Thumbs.db

# Backup files
*.bak
*.tmp
*.orig

# Documentation generated
docs/generated/

# Environment
.env
.env.local

# Test coverage
*.profraw
coverage/

# Internal
advisory-db/
test_safe_canonicalize

# Skill directory copies (canonical: .opencode/skills/)
.skills/
.agents/skills/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
.venv-ci/
crates/eggsec-python/dist/

# Performance harness generated output (Phase A; summaries live in
# architecture/performance.md, raw logs are never committed)
/perf-results/
*.perf.log
*.perf.jsonl
